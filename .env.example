# JGWL 管理系统环境配置示例
# 复制此文件为 .env 并修改相应配置

# ============================================
# 数据库配置
# ============================================
DB_HOST=123.56.164.133
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-database-password
DB_NAME=jgwl_db

# ============================================
# JWT 认证配置
# ============================================
# ⚠️ 生产环境必须修改为强随机字符串（至少32字符）
# 可以使用以下命令生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-random-string-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================
# AES 加密配置（如果使用加密功能）
# ============================================
AES_KEY=your-aes-key-here-16-32-chars
AES_IV=your-aes-iv-here-16-chars

# ============================================
# 应用配置
# ============================================
PROJECT_NAME=JGWL 管理系统
VERSION=1.0.0
API_V1_STR=/api/v1

# ============================================
# CORS 配置（开发环境）
# ============================================
# 生产环境请在 main.py 中修改允许的域名
# ALLOWED_ORIGINS=http://your-domain.com,https://your-domain.com

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ============================================
# 其他配置
# ============================================
# DEBUG=true  # 生产环境请注释掉或删除此行
